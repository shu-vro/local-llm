{
  "expo": {
    "name": "Local LLM",
    "slug": "local-llm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "localllm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localllm.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Local LLM to attach photos from your library to chat messages. Photos stay on your device.",
        "NSCameraUsageDescription": "Allow Local LLM to take photos for chat messages. Photos stay on your device.",
        "NSMicrophoneUsageDescription": "Allow Local LLM to record audio clips for chat messages. Audio stays on your device."
      }
    },
    "android": {
      "package": "com.localllm.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Local LLM to attach photos from your library to chat messages.",
          "cameraPermission": "Allow Local LLM to take photos for chat messages.",
          "microphonePermission": "Allow Local LLM to record audio clips for chat messages."
        }
      ],
      "expo-file-system",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8aab719d-69a6-4c00-ab2d-4359f5f4248a"
      }
    }
  }
}
